{
  "name": "apiuikit",
  "version": "1.3.0",
  "description": "A React UI library for rendering your API specifications",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AceTheCreator/apiuikit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AceTheCreator/apiuikit"
  },
  "homepage": "https://apiuikit.com",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/apiuikit.cjs.js",
  "module": "./dist/apiuikit.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/apiuikit.es.js",
      "require": "./dist/apiuikit.cjs.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.es.js",
      "require": "./dist/markdown.cjs"
    },
    "./style.css": "./dist/apiuikit.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.markdown.config.ts",
    "watch": "vite build --watch",
    "prepublishOnly": "cp ../../README.md ./README.md && npm run build",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:strict": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:models": "tsx src/scripts/generateAsyncAPIModel.ts"
  },
  "dependencies": {
    "@asyncapi/specs": "^6.8.1",
    "@json-schema-tools/reference-resolver": "^1.2.6",
    "@readme/httpsnippet": "^11.4.0",
    "asyncsnippet": "^0.3.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^2.24.0",
    "json-schema-faker": "^0.6.2",
    "json-schema-resolver": "^3.0.0",
    "marked": "^15.0.11",
    "marked-highlight": "^2.2.1",
    "openapi-types": "^12.1.3",
    "protobufjs": "^7.4.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "url": "^0.11.4"
  },
  "peerDependencies": {
    "@asyncapi/parser": "^3.6.0",
    "@scalar/openapi-parser": "^0.28.10",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@asyncapi/parser": {
      "optional": true
    },
    "@scalar/openapi-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@asyncapi/modelina": "^5.10.1",
    "@asyncapi/parser": "^3.6.0",
    "@scalar/openapi-parser": "^0.28.10",
    "@chromatic-com/storybook": "^3.2.3",
    "@eslint/js": "^9.17.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-storybook": "^0.11.2",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "marked-linkify-it": "^3.1.12",
    "postcss": "^8.4.49",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "x-tensions": "*"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
