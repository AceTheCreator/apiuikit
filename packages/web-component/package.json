{
  "name": "@apiuikit/web-component",
  "version": "1.5.0",
  "description": "Framework-agnostic web components for apiuikit — full-document and per-section (servers, operations, messages, schemas, info) custom elements for AsyncAPI and OpenAPI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AceTheCreator/apiuikit",
    "directory": "packages/web-component"
  },
  "type": "module",
  "main": "./dist/web-component.iife.js",
  "module": "./dist/web-component.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-component.es.js",
      "default": "./dist/web-component.iife.js"
    },
    "./asyncapi": {
      "types": "./dist/elements/asyncapi.d.ts",
      "import": "./dist/elements/asyncapi.js"
    },
    "./asyncapi-renderer": {
      "types": "./dist/elements/asyncapi-renderer.d.ts",
      "import": "./dist/elements/asyncapi-renderer.js"
    },
    "./asyncapi-servers": {
      "types": "./dist/elements/asyncapi-servers.d.ts",
      "import": "./dist/elements/asyncapi-servers.js"
    },
    "./asyncapi-operations": {
      "types": "./dist/elements/asyncapi-operations.d.ts",
      "import": "./dist/elements/asyncapi-operations.js"
    },
    "./asyncapi-messages": {
      "types": "./dist/elements/asyncapi-messages.d.ts",
      "import": "./dist/elements/asyncapi-messages.js"
    },
    "./asyncapi-info": {
      "types": "./dist/elements/asyncapi-info.d.ts",
      "import": "./dist/elements/asyncapi-info.js"
    },
    "./openapi": {
      "types": "./dist/elements/openapi.d.ts",
      "import": "./dist/elements/openapi.js"
    },
    "./openapi-renderer": {
      "types": "./dist/elements/openapi-renderer.d.ts",
      "import": "./dist/elements/openapi-renderer.js"
    },
    "./openapi-servers": {
      "types": "./dist/elements/openapi-servers.d.ts",
      "import": "./dist/elements/openapi-servers.js"
    },
    "./openapi-endpoints": {
      "types": "./dist/elements/openapi-endpoints.d.ts",
      "import": "./dist/elements/openapi-endpoints.js"
    },
    "./openapi-webhooks": {
      "types": "./dist/elements/openapi-webhooks.d.ts",
      "import": "./dist/elements/openapi-webhooks.js"
    },
    "./openapi-info": {
      "types": "./dist/elements/openapi-info.d.ts",
      "import": "./dist/elements/openapi-info.js"
    },
    "./schemas": {
      "types": "./dist/elements/schemas.d.ts",
      "import": "./dist/elements/schemas.js"
    },
    "./style.css": "./dist/web-component.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.elements.config.ts",
    "watch": "vite build --watch & vite build --config vite.elements.config.ts --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "demo": "npm run build && serve . -l 8735"
  },
  "dependencies": {
    "@r2wc/react-to-web-component": "^2.1.1",
    "apiuikit": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serve": "^14.2.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^5.0.3"
  }
}
